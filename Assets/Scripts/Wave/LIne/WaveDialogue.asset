  lines:
  - speaker: '?'
    text: "\uBB50\uC57C \uC5B8\uC81C \uC2E4\uD5D8\uC774 \uC2DC\uC791\uD588\uB370?"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: -334280222365038071, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: '?'
    text: "\uC74C \uC2E4\uD5D8\uCCB4 X? \uB77C\uACE0 \uD588\uB098 \uC798 \uBD80\uD0C1\uD560\uAC8C. "
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1251645041, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: x
    text: ....
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 0}
  - speaker: '?'
    text: "\uC74C \uBB50\uAC00 \uBB38\uC81C\uAC00 \uC788\uB098?"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 912176082, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: '?'
    text: "\uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uB294 \uD45C\uC815\uC778\uB370?"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 912176082, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: '?'
    text: "\uC74C.. \uC9C1\uC811\uC801\uC73C\uB85C \uB3C4\uC6C0\uC744 \uC904 \uC218\uB294
      \uC5C6\uC73C\uB2C8\uAE4C \uC791\uC740 \uB3C4\uC6C0\uC774\uB77C\uB3C4 \uC904\uAC8C"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1251645041, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: '?'
    text: "\uC790 \uB2E4\uC2DC \uC2E4\uD5D8\uC744 \uC2DC\uC791\uD574 \uBCFC\uAE4C"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1679258638, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
