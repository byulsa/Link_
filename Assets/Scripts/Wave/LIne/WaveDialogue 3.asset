  m_Script: {fileID: 11500000, guid: e27a450c41b7453f9670942fdf3ed028, type: 3}
  m_Name: WaveDialogue 3
  m_EditorClassIdentifier: Assembly-CSharp::WaveDialogue
  lines:
  - speaker: "\uC5F0\uAD6C\uC6D0 A"
    text: "\uC2E4\uD5D8\uC774 \uC21C\uC870\uB86D\uAC8C \uC9C4\uD589\uB418\uB294\uAD70"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 0}
  - speaker: "\uC5F0\uAD6C\uC6D0 B"
    text: "\uADF8\uB7EC\uAC8C \uC800\uBC88\uCC98\uB7FC \uBE68\uB9AC \uC8FD\uC9C0\uB3C4
      \uC54A\uACE0"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 0}
  - speaker: V
    text: "\uC5F0\uAD6C\uC6D0\uB4E4\uC544 \uB108\uD76C\uB4E4\uC740 \uB2E4\uB978 \uC77C
      \uD558\uB7EC\uAC00"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1677258925, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: "\uC5F0\uAD6C\uC6D0 A, B"
    text: "\uC544..\uB135"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 0}
  - speaker: V
    text: "\uC548\uB155? \uB2E4\uC2DC \uB9CC\uB098\uB7EC \uC654\uC5B4 "
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: -334280222365038071, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: X
    text: ...
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: -334280222365038071, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: V
    text: "\uB300\uB2F5 \uC5C6\uB294\uAC74 \uC5EC\uC804\uD558\uB124."
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1251645041, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: V
    text: "\uB108\uD55C\uD14C \uC9C0\uAE08 'P'\uAC00 \uC788\uC744\uAC70\uC57C."
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1251645041, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: V
    text: "\uADF8 'P'\uD558\uACE0 \uD559\uC2B5 \uB370\uC774\uD130\uD558\uACE0 \uAD50\uD658\uD558\uBA74
      \uC5B4\uB5A8\uAE4C \uD574\uC11C"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: -334280222365038071, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  - speaker: V
    text: "\uBB3C\uB860 \uBE44\uBC00\uC774\uB2C8\uAE4C \uC5F0\uAD6C\uC6D0\uC774\uB4E0
      \uB204\uAD6C\uD55C\uD14C\uB4E0 \uC54C\uB824\uC8FC\uC9C0\uB9D0\uACE0"
    font: {fileID: 11400000, guid: feb303a3559bf9441b5f601af038b9fc, type: 2}
    fontSize: 0
    portrait: {fileID: 1679258638, guid: fc6f879ceff9c6a4fb1f08a4617cbbbb, type: 3}
  completionReward: 2
